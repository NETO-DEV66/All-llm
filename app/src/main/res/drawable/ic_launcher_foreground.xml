<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Glass droplet body: translucent, lit from the upper left. -->
    <path android:pathData="M54,28 C65,41 73,50 73,61 A19,19 0 0 1 35,61 C35,50 43,41 54,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="35" android:startY="28"
                android:endX="73" android:endY="80">
                <item android:offset="0" android:color="#F2F8FF" />
                <item android:offset="0.45" android:color="#A9CDF2" />
                <item android:offset="1" android:color="#4E7FE0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Refraction rim: a thin bright edge where the glass bends the backdrop. -->
    <path
        android:pathData="M54,28 C65,41 73,50 73,61 A19,19 0 0 1 35,61 C35,50 43,41 54,28 Z"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.55"
        android:strokeWidth="1.6" />
    <!-- Specular highlight. -->
    <path
        android:pathData="M46,52 m-6,0 a6,8 0 1 0 12,0 a6,8 0 1 0 -12,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.6" />
    <!-- Warm core: the "LLM" spark carried through the glass. -->
    <path
        android:pathData="M54,50 m-7,0 a7,7 0 1 0 14,0 a7,7 0 1 0 -14,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="50" android:gradientRadius="9">
                <item android:offset="0" android:color="#FFF1E4" />
                <item android:offset="0.6" android:color="#F9A46B" />
                <item android:offset="1" android:color="#F28C52" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
